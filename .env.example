# ─────────────────────────────────────────────────────────────
# Oriole — SaaS Booking System
# Salin file ini menjadi `.env` di root repo, lalu isi nilai-nilainya.
# `.env` tidak boleh di-commit. Semua placeholder di bawah membuat
# aplikasi bisa boot secara lokal (nilai asli hanya dibutuhkan saat
# integrasi layanan sungguhan).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# App
APP_NAME="Oriole"
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
# Base URL publik untuk webhook inbound (Telegram/WhatsApp/WAHA) — WAJIB HTTPS
# publik di produksi (Telegram menolak http/localhost). Kosong → jatuh ke API_URL.
WEBHOOK_BASE_URL=
PORT=3000

# ── Database · Neon (serverless PostgreSQL) ──────────────────
# Pooled connection string dari Neon Console (Project → Connection Details).
# https://neon.tech/docs/connect/connect-from-any-app
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.neon.tech/neondb?sslmode=require

# ── Neon Auth (Managed Better Auth) ──────────────────────────
# Endpoint auth dari Neon Console (Project → Auth). JWT diverifikasi
# terhadap JWKS remote di `${NEON_AUTH_URL}/.well-known/jwks.json`.
# https://neon.tech/docs/guides/neon-auth
NEON_AUTH_URL=https://ep-xxxx.neon.tech/neondb/auth

# ── Paddle Billing (Merchant of Record) ───────────────────────
# https://developer.paddle.com
# PADDLE_API_KEY juga dipakai integrasi "Payments" (Global Payments):
# payment link satu kali untuk pembayaran customer (deposit/biaya layanan)
# dibuat server-side dengan non-catalog price — tanpa PADDLE_CLIENT_TOKEN.
# Pastikan webhook endpoint /api/webhooks/paddle menerima event
# transaction.completed & transaction.canceled (selain subscription.*).
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_...
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
# Price ID paket Pro dari Paddle Catalog (untuk POST /api/billing/checkout).
# PERHATIAN: `unit_price.amount` Paddle memakai MINOR UNITS (sen) —
# $29.00/bulan = amount "2900", bukan "29". Nilai di bawah $0.70 membuat
# checkout gagal dengan error transaction_balance_less_than_charge_limit.
PADDLE_PRO_PRICE_ID=

# ── Inngest (background jobs & webhook orchestration) ────────
# https://www.inngest.com/docs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Resend (email) ────────────────────────────────────────────
# https://resend.com/docs
RESEND_API_KEY=re_...

# ── Enkripsi at-rest pesan inbox ─────────────────────────────
# Master key 32 byte (64 hex char) untuk enkripsi konten pesan inbox
# (AES-256-GCM; kunci per-workspace diturunkan via HKDF dari key ini).
# Buat dengan: openssl rand -hex 32
# KOSONG = enkripsi nonaktif (pesan tersimpan plaintext — cukup untuk dev).
# PERINGATAN: setelah pesan terenkripsi, mengganti/kehilangan key ini membuat
# pesan lama tidak terbaca (decrypt gagal → placeholder "[encrypted]").
MESSAGE_ENCRYPTION_KEY=

# ── Vapi (AI voice calls) — menggantikan CALL-E ───────────────
# https://dashboard.vapi.ai (API Keys) — platform voice AI agent.
VAPI_API_KEY=vapi_...
# ID nomor telepon Vapi untuk panggilan keluar (Phone Numbers → pilih nomor).
# Nomor gratis Vapi hanya US; untuk internasional impor nomor Twilio/Telnyx.
VAPI_PHONE_NUMBER_ID=phone-number-id
# Shared secret otentikasi webhook Vapi — dikirim Vapi sebagai header
# `Authorization: Bearer <secret>` (dikonfigurasi di assistant.server.headers
# pada kode; tidak perlu setup credential dashboard). Tanpa secret ini
# endpoint /api/webhooks/vapi menolak semua event (fail-closed).
VAPI_WEBHOOK_SECRET=
# Default LLM & suara TTS asisten (bisa diubah bebas; lihat docs Vapi).
VAPI_MODEL=gpt-4o-mini
VAPI_VOICE_ID=cgSgspJ2msm6clMCkdW9

# ── Telnyx (BYO phone number untuk Vapi) ────────────────────────
# Runtime API TIDAK butuh Telnyx — panggilan tetap lewat VAPI_PHONE_NUMBER_ID;
# Telnyx hanya penyedia nomor di balik layar (impor nomor ke Vapi).
# Env ini dipakai script provisioning/ops:
#   pnpm --filter @oriole/api setup:telnyx   # cari/beli nomor + daftarkan ke Vapi
#   pnpm --filter @oriole/api telnyx:status  # cek status nomor & kredensial
# API key v2 dari portal.telnyx.com (dedicated untuk Vapi — jangan dipakai
# integrasi lain). WAJIB ada di env saat menjalankan setup:telnyx.
TELNYX_API_KEY=
# Nomor Telnyx pilihan (E.164, contoh +6281234567890). Kosong = script mencari
# & membeli nomor baru berdasarkan TELNYX_COUNTRY_CODE / --country.
TELNYX_PHONE_NUMBER=
# Negara default pencarian nomor baru (ISO 3166-1 alpha-2).
TELNYX_COUNTRY_CODE=US
# ID kredensial Telnyx DI SISI VAPI — dibuat SEKALI di dashboard.vapi.ai
# (Keys → buat credential Telnyx, tempel TELNYX_API_KEY). Wajib untuk
# mendaftarkan nomor ke Vapi. Lihat docs/deployment.md → bagian Telnyx.
VAPI_TELNYX_CREDENTIAL_ID=

# ── Telegram (chat channel — MVP) ─────────────────────────────
# Fallback development. Di produksi, token & secret per-workspace
# disimpan di tabel workspace_channels (multi-tenant).
# Bila diisi, halaman Channels menampilkan bot ini sebagai "bot bersama" dan
# user bisa menghubungkannya ke project dengan sekali klik (tanpa input token
# BotFather) via POST /api/channels/telegram/connect.
# Buat bot via @BotFather → dapatkan token, lalu:
#   TELEGRAM_BOT_TOKEN=123456:ABC...
#   TELEGRAM_WEBHOOK_SECRET=generate random string
# Set webhook: https://api.telegram.org/bot<TOKEN>/setWebhook?url=<API_URL>/api/webhooks/telegram/<workspaceId>&secret_token=<SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── WhatsApp via 360dialog (BSP) — Phase 2 ───────────────────
# API key dari dashboard 360dialog (waba.360dialog.io). Webhook secret
# adalah App Secret yang dipakai Meta untuk X-Hub-Signature-256.
# Template reminder harus dibuat & di-approve di Meta (kategori utility).
WHATSAPP_API_KEY=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_TEMPLATE_REMINDER=booking_reminder

# ── WhatsApp Business via Meta Embedded Signup (Tech Provider) ──
# Meta App milik PLATFORM (bukan tenant): tiap tenant menghubungkan nomor
# mereka lewat dialog resmi Meta tanpa menempel token/ID apa pun.
# Jalankan `pnpm --filter @oriole/api setup:whatsapp` untuk memvalidasi env
# ini + mencetak langkah dashboard Meta & URL callback/webhook yang persis.
#   META_WHATSAPP_APP_ID           = App ID platform
#   META_WHATSAPP_APP_SECRET       = App Secret (X-Hub-Signature-256 webhook)
#   META_WHATSAPP_CONFIG_ID        = Config ID Embedded Signup (App Dashboard →
#                                    WhatsApp → Embedded Signup → Configuration)
#   META_WHATSAPP_VERIFY_TOKEN     = verify token webhook (hub.challenge)
#   META_WHATSAPP_SYSTEM_USER_TOKEN= system user token platform (resolve WABA ID)
#   META_GRAPH_API_VERSION         = versi Graph API (default v21.0)
META_WHATSAPP_APP_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_SYSTEM_USER_TOKEN=
META_GRAPH_API_VERSION=v21.0

# ── WhatsApp BYO (unofficial, WAHA) — gateway ter-managed server ──
# WAJIB untuk BYO: kredensial SELALU dari server — dialog "Bring your own
# number" tidak lagi menampilkan field gateway URL/API key; backend memakai
# kredensial ini untuk semua workspace (tinggal consent + scan QR). Tanpa
# keduanya, setup BYO ditolak dengan pesan jelas.
#   WAHA_GATEWAY_URL=http://localhost:3002
#   WAHA_GATEWAY_API_KEY=<plain key dari deploy/waha/.env — WAHA_API_KEY_PLAIN>
WAHA_GATEWAY_URL=
WAHA_GATEWAY_API_KEY=

# ── AI chat (WhatsApp Q&A knowledge base) ─────────────────────
# Endpoint OpenAI-compatible. Default Groq free tier: Llama 3.3 70B, tanpa
# kartu kredit — key gsk_ dari https://console.groq.com (menu API Keys).
# Tanpa API key fitur AI mati total: bot jatuh ke handoff staf (perilaku
# lama), tidak pernah error.
AI_CHAT_BASE_URL=https://api.groq.com/openai/v1
AI_CHAT_API_KEY=
AI_CHAT_MODEL=llama-3.3-70b-versatile

# ── Enkripsi kredensial at-rest (providerConfig integrasi) ────
# AES-256-GCM. Generate 32-byte hex: openssl rand -hex 32
# Kosong = mode kompatibilitas (token disimpan plaintext) — TIDAK disarankan
# di produksi.
APP_ENCRYPTION_KEY=

# ── PostHog analytics (server-side) ───────────────────────────
# Project API key (`phc_...`, dari Project Settings → API keys) — key yang
# SAMA dengan token web SDK. BUKAN personal API key (`phx_...`), yang hanya
# untuk REST API privat dan DITOLAK endpoint capture.
# Kosong = analitik server nonaktif (semua capture di-skip, API tetap jalan).
POSTHOG_PUBLIC_KEY=
# US = https://us.i.posthog.com, EU = https://eu.i.posthog.com (pilih saat
# project dibuat — tidak bisa diubah belakangan).
POSTHOG_HOST=https://us.i.posthog.com

# ── Frontend (dibaca Vite, prefix VITE_) ──────────────────────
# Di development Vite mem-proxy /api ke localhost:3000, jadi cukup "/api".
VITE_API_URL=/api
VITE_NEON_AUTH_URL=https://ep-xxxx.neon.tech/neondb/auth
# ── PostHog analytics (frontend) ───────────────────────────────
# Project API key / token (`phc_...`, Project Settings → API keys) — aman
# diekspos di bundle browser. Nilai SAMA dengan POSTHOG_PUBLIC_KEY server.
# Kosong = analitik frontend nonaktif (app tetap jalan normal).
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
