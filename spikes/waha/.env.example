# docker compose reads this file automatically for variable substitution.
# Copy to .env and change the secrets before running the spike.

# Used by the WAHA container (REST API auth). Long random string (UUIDv4-like).
WAHA_API_KEY=spike-waha-change-me-00000000000000000000000000000000

# Dashboard / Swagger credentials (http://localhost:3000/dashboard)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=spike-admin-change-me-11111111111111111111111111111111
