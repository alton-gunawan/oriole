[TEMPLATE]
# ════════════════════════════════════════════════════════════════════
# WAHA gateway — environment template (Oriole "Bring Your Own WhatsApp")
#
# Copy to .env and change ALL secrets:
#   cp .env.example .env
# …or generate a ready-to-use .env with fresh random secrets:
#   ./scripts/init-env.sh
# ════════════════════════════════════════════════════════════════════

# Version pin — WAHA tags are engine-split. THIS FILE'S DEFAULTS TARGET
# APPLE SILICON (ARM): noweb-arm = NOWEB engine (browserless) + ARM.
# On an x86 server use:  noweb-2026.7.2   (or latest-2026.7.2 for the
# default WEB engine). Bump deliberately; session data survives upgrades
# (data/ volumes).
WAHA_IMAGE_TAG=noweb-arm-2026.7.2

# Admin API key — every WAHA request requires it (v2026+). Stored as a
# sha512 HASH (docs-recommended): only the hash is visible in the container
# env. The PLAIN key (WAHA_API_KEY_PLAIN) is the "Gateway API key" you paste
# into Oriole.
WAHA_API_KEY=sha512:change-me-to-the-sha512-hash-of-your-key
WAHA_API_KEY_PLAIN=change-me-to-a-long-random-string-at-least-32-chars

# Dashboard login (http://localhost:<WAHA_PORT>/dashboard) — same origin as
# the API, so pick a strong password and never reuse the API key.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me-to-another-long-random-string

# Swagger panel login (http://localhost:<WAHA_PORT>/) — protects the interactive docs.
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=change-me-to-a-third-long-random-string

# Bind address: 127.0.0.1 = localhost only (safe default). Set 0.0.0.0 only
# when the Oriole API server must reach this gateway over the network, and
# always put a TLS reverse proxy / tunnel in front (see README).
WAHA_BIND_ADDR=127.0.0.1

# Host port for the WAHA API. Default 3002 so it never collides with the
# Oriole API dev server (which commonly owns 3000). This is the port in your
# Oriole Gateway URL: http://localhost:<WAHA_PORT>
WAHA_PORT=3002

# Optional: device name shown under WhatsApp → Linked devices.
# ⚠️ A custom device name BREAKS the "Link with phone number" (pairing code)
# flow that Oriole also offers — only set this if you always pair via QR.
# WAHA_CLIENT_DEVICE_NAME=Oriole

# Container timezone (log + dashboard timestamps).
TZ=Asia/Jakarta

# ── Full-stack dev overlay (docker-compose.dev.yml) ──────────────
# One command runs WAHA + Oriole API + Inngest Dev Server:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build
# These only apply to the dev overlay (the plain `docker compose up` in
# production ignores them). See README → "Full stack in one command".

# Host port for the Oriole API container (Vite proxies /api → this port).
ORIOLE_API_PORT=3000

# Host port for the Inngest Dev Server UI (http://localhost:<INNGEST_PORT>).
INNGEST_PORT=8288

# Inngest Dev Server image tag (pin a tested release for reproducibility).
INNGEST_IMAGE_TAG=latest
